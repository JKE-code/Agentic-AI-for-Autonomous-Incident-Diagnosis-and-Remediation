{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnosis",
  "type": "object",
  "required": [
    "incident_id",
    "status",
    "timeline",
    "hypotheses",
    "root_cause",
    "evidence",
    "remediation",
    "confidence",
    "requires_more_data"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["DIAGNOSING", "DIAGNOSIS_COMPLETE", "INSUFFICIENT_DATA", "FAILED"]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "service": { "type": "string" },
          "event": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "cause", "service", "score", "confidence", "supporting_evidence", "contradicting_evidence", "status"],
        "properties": {
          "hypothesis_id": { "type": "string" },
          "cause": { "type": "string" },
          "service": { "type": "string" },
          "score": { "type": "number" },
          "confidence": { "type": "number" },
          "supporting_evidence": { "type": "array", "items": { "type": "string" } },
          "contradicting_evidence": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" }
        }
      }
    },
    "root_cause": {
      "type": "object",
      "properties": {
        "hypothesis_id": { "type": "string" },
        "cause": { "type": "string" },
        "service": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence.schema.json" }
    },
    "remediation": {
      "$ref": "remediation.schema.json"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_more_data": {
      "type": "boolean"
    },
    "audit_events": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
