{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incident",
  "type": "object",
  "required": ["incident_id", "title", "severity", "started_at", "services"],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^INC-\\d{3,}$"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "services": {
      "type": "array",
      "items": { "type": "string" }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "service": { "type": "string" },
          "level": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "service": { "type": "string" },
          "metric_name": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        }
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trace_id": { "type": "string" },
          "span_id": { "type": "string" },
          "service": { "type": "string" },
          "operation": { "type": "string" },
          "duration_ms": { "type": "number" },
          "status_code": { "type": "integer" }
        }
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "commit": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caller": { "type": "string" },
          "callee": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
