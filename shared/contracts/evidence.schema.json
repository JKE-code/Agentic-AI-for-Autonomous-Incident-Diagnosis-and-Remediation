{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "description": "Structured observability evidence supporting or contradicting hypotheses",
  "type": "object",
  "required": [
    "evidence_id",
    "source",
    "timestamp",
    "service",
    "observation",
    "importance",
    "supports",
    "contradicts",
    "confidence"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "example": "E-001"
    },
    "source": {
      "type": "string",
      "enum": ["logs", "metrics", "traces", "deployments", "dependencies", "diagnostics"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "raw_ref": {
      "type": "object",
      "description": "Optional reference to underlying log line, trace ID, or metric timestamp"
    }
  }
}
