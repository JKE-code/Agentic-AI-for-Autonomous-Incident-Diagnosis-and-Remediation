{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "required": ["evidence_id", "source", "timestamp", "service", "observation", "importance", "supports", "contradicts", "confidence"],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": ["logs", "metrics", "traces", "deployments", "dependencies", "diagnostics"]
    },
    "timestamp": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "supports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contradicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
